# Copy to .env and edit. NEVER commit .env. Values below are placeholders, not real secrets.

# --- Postgres (used by docker compose and the backend) ---
POSTGRES_USER=arl
POSTGRES_PASSWORD=settpainghtin
POSTGRES_DB=arl

# --- Backend ---
# Local (non-docker) example; compose builds its own URL from the POSTGRES_* values.
DATABASE_URL=postgresql+psycopg://arl:change-me-locally@localhost:5432/arl
# Shared secret required in the X-API-Key header. Leave empty ONLY for local development.
# Generate one with: openssl rand -hex 32
API_KEY=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
MOCK_SIMULATE_LATENCY=true

# --- Frontend (server-side only; never exposed to the browser) ---
BACKEND_URL=http://localhost:8000
